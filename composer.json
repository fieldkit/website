{
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "extra": {
    "installer-paths": {
      "wordpress/wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ]
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "composer",
      "url": "https://composer.advancedcustomfields.com"
    }
  ],
  "require": {
    "wpackagist-plugin/adminimize": "^1.11",
    "wpackagist-plugin/akismet": "^5.4",
    "wpackagist-plugin/cf7-conditional-fields": "^2.5",
    "wpackagist-plugin/classic-editor": "^1.5",
    "wpackagist-plugin/contact-form-7": "^6.0",
    "wpackagist-plugin/duplicate-post": "^4.5",
    "wpackagist-plugin/flamingo": "^2.1",
    "wpackagist-plugin/jetpack": "^14.7",
    "wpackagist-plugin/redirection": "^5.5",
    "wpackagist-plugin/w3-total-cache": "^2.8",
    "wpackagist-plugin/woocommerce": "^9.9.4",
    "wpackagist-plugin/wordfence": "^8.0",
    "wpackagist-plugin/wordpress-seo": "^25.3.1",
    "wpackagist-plugin/wp-ses": "^1.3",
    "wpackagist-plugin/wp-smushit": "^3.6",
    "wpengine/advanced-custom-fields": "^6.4",
    "wpengine/advanced-custom-fields-pro": "*"
  }
}
